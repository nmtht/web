# === Root (Astro site) ===
# Copy to .env and fill in values from https://manage.sanity.io

# Project ID — same for both PUBLIC_ and SANITY_STUDIO_
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional: API token with Viewer or Editor rights (for private datasets / write)
SANITY_API_TOKEN=

# Studio uses the same project (kept in root for convenience)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
