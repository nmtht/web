---
// RU / EN toggle — bottom right, no border.
---
<button id="langToggle" class="brand-hover" aria-label="Switch language">RU</button>

<style>
  #langToggle {
    position: fixed;
    right: var(--gutter);
    bottom: 24px;
    z-index: 60;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
</style>
