---
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import LangToggle from '../components/LangToggle.astro';
import GraphIsland from '../components/graph/GraphIsland';
import { sanity } from '../lib/sanity-client';
import { mapContent } from '../lib/queries';

let content = null;
let fetchError = null;

try {
  content = await sanity.fetch(mapContent);
} catch (e) {
  fetchError = e instanceof Error ? e.message : String(e);
  console.error('[index] Sanity fetch failed:', e);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>name that! — nt!</title>
    <meta name="description" content="name that! — a map of thinking. click to expand." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link
      rel="preload"
      href="https://mathfonts.github.io/LatinModern/latinmodern-math.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:global>
      /*
        Latin Modern Math ships as a single upright face.
        Register it for both normal and italic so `font-style: italic`
        does not fall back to Georgia/system (which looked "bold").
      */
      @font-face {
        font-family: 'Latin Modern Math';
        src: url('https://mathfonts.github.io/LatinModern/latinmodern-math.woff2') format('woff2'),
             url('https://mathfonts.github.io/LatinModern/latinmodern-math.woff') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Latin Modern Math';
        src: url('https://mathfonts.github.io/LatinModern/latinmodern-math.woff2') format('woff2'),
             url('https://mathfonts.github.io/LatinModern/latinmodern-math.woff') format('woff');
        font-weight: 400;
        font-style: italic;
        font-display: block;
      }
      :root {
        --black: #111110;
        --white: #ffffff;
        --grey-light: #e4e2dd;
        --gutter: clamp(20px, 4vw, 64px);
        --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
        /* No Georgia/system in the stack — avoids weight flash */
        --font-display: 'Latin Modern Math', serif;
        --mark-size: clamp(28px, 4vw, 48px);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; overflow: hidden; background: var(--white); color: var(--black); }
      body {
        font-family: var(--font-body);
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        font-synthesis: none;
      }
      /* Display marks: fixed weight, no synthetic bold/italic */
      .font-display,
      #preloader-mark,
      .logo,
      .n-seed-btn,
      .n-main-btn,
      .n-q-btn {
        font-family: var(--font-display);
        font-weight: 400;
        font-style: italic;
        font-synthesis: none;
        -webkit-font-smoothing: antialiased;
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; text-align: left; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--black); outline-offset: 3px; }
      .brand-hover {
        font-family: var(--font-body);
        font-style: normal;
        text-transform: none;
        transition: font-family .18s ease, font-style .18s ease, opacity .3s ease;
      }
      .brand-hover:hover,
      .brand-hover:focus-visible {
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 400;
        text-transform: lowercase;
        font-synthesis: none;
      }
    </style>
  </head>
  <body>
    <Preloader />
    <Header />
    <div id="stage">
      <GraphIsland client:only="react" content={content} fetchError={fetchError} />
    </div>
    <LangToggle />
  </body>
</html>
